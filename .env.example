# --- GCP platform ---
# Required. Your Google Cloud project ID.
GCP_PROJECT_ID=your-project-id
# Required for deploy. Cloud Run / Artifact Registry region.
GCP_REGION=us-central1

# --- Model ---
# Required for deploy. Must be a model your project can actually call.
# Check first: ./deploy/list_models.sh          (regional)
#              ./deploy/list_models.sh global    (if the model is global-only)
MODEL_NAME=gemini-2.5-flash
MODEL_TEMPERATURE=0.2
# Vertex serves some models only from the global endpoint. If list_models says
# so, set VERTEX_LOCATION=global.
VERTEX_LOCATION=us-central1

# --- ADK backend ---
# vertex  -> Vertex AI via the runtime service account / local ADC. No API key.
# api_key -> Gemini API key. Locally: put it in GEMINI_API_KEY below.
#            On Cloud Run: stored in Secret Manager (ADK_GEMINI_API_KEY).
ADK_BACKEND=vertex
GEMINI_API_KEY=
GEMINI_API_KEY_SECRET=ADK_GEMINI_API_KEY

# --- Naming / ownership (deploy) ---
# Lowercase, 3-25 chars, start with a letter. Everything is prefixed with this
# so it cannot collide with other deployments in the same project.
SERVICE_PREFIX=adk
# Optional overrides (sensible defaults shown):
# ARTIFACT_REPO=${SERVICE_PREFIX}-csuite
# RUNTIME_SA_NAME=${SERVICE_PREFIX}-csuite-runtime
# SERVICE_MEMORY=2Gi
# SERVICE_CPU=2
# SERVICE_TIMEOUT=3600
# SERVICE_MIN_INSTANCES=1
# VERIFY_ATTEMPTS=6
# VERIFY_DELAY_SECONDS=10

# --- Agents ---
ACTIVE_ROLES_CSV=cfo,cso,cmo,chro,cto
AGENT_TIMEOUT_SECONDS=180
AGENT_MAX_RETRIES=1
ROUTING_MODE=llm
ROUTING_MIN_ROLES=1
ROUTING_MAX_ROLES=5

# --- Human in the loop ---
HITL_ENABLED=true
HITL_PLAN_APPROVAL=true
HITL_CONFIDENCE_FLOOR=0.75
HITL_REQUIRE_CITATIONS=true
HITL_FINAL_SIGNOFF=true
HITL_TIMEOUT_SECONDS=900

# --- Decision log ---
# memory    -> in-process only (fine for demo; service is max-instances 1).
# firestore -> durable; grants roles/datastore.user during deploy.
DECISION_LOG_BACKEND=memory
FIRESTORE_COLLECTION=adk_csuite_decision_log

# --- Uploads ---
MAX_UPLOAD_BYTES=1048576
ALLOWED_UPLOAD_EXTENSIONS_CSV=.md,.markdown,.txt,.csv

# --- Local run ---
# run_local.sh serves on 127.0.0.1:8081 by default so it can sit beside
# Option 1 on 8080.
LOCAL_PORT=8081
LOG_LEVEL=INFO
